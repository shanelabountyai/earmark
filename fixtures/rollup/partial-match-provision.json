  "input": {
    "programs": [
      {
        "id": "p1"
      }
    ],
    "campaigns": [
      {
        "id": "c1",
        "programId": "p1"
      }
    ],
    "lines": [
      {
        "id": "l1",
        "campaignId": "c1",
        "periodId": "m1",
        "plannedCents": 1000000
      }
    ],
    "commitments": [
      {
        "id": "po-a",
        "lineId": "l1",
        "amountCents": 300000,
        "state": "closed"
      },
      {
        "id": "po-b",
        "lineId": "l1",
        "amountCents": 200000,
        "state": "open"
      }
    ],
    "matches": [
      {
        "invoiceId": "i1",
        "commitmentId": "po-a",
        "amountCents": 300000,
        "state": "pending"
      },
      {
        "invoiceId": "i3",
        "commitmentId": "po-b",
        "amountCents": 80000,
        "state": "pending"
      }
    ],
    "invoices": [
      {
        "id": "i1",
        "amountCents": 500000,
        "state": "submitted",
        "lineId": "l1"
      },
      {
        "id": "i2",
        "amountCents": 100000,
        "state": "submitted",
        "lineId": "l1",
        "matchedCents": 40000
      },
      {
        "id": "i3",
        "amountCents": 80000,
        "state": "submitted",
        "lineId": "l1"
      }
    ]
  },
  "expect": {
    "ok": true,
    "rollup": {
      "lines": [
        {
          "lineId": "l1",
          "committedCents": 500000,
          "actualCents": 0,
          "unmatchedProvisionCents": 260000,
          "availableCents": 240000
        }
      ],
      "unmatchedInvoices": [
        {
          "invoiceId": "i1",
          "amountCents": 500000,
          "unmatchedCents": 200000
        },
        {
          "invoiceId": "i2",
          "amountCents": 100000,
          "unmatchedCents": 60000
